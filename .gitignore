# ===========================
# SmartWin .gitignore
# ===========================

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js / Frontend
node_modules/
dist/
build/
.nuxt/
.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.idea/
*.iml
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment / Config
.env
.env.local
.env.*.local
application-local.yml
application-local.properties
*.secret

# Docker
docker-compose.override.yml

# Test reports
test-results/
surefire-reports/
jacoco.exec
coverage/

# Logs
logs/
*.log
log/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Build artifacts
*.o
*.a
*.so
*.dll
*.dylib

# OS specific
.DS_Store
.AppleDouble
.LSOverride
desktop.ini
$RECYCLE.BIN/
