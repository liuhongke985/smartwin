.PHONY: help init setup lint test build clean ci quality security release docs standards monitoring

help:
	@echo "SmartWin Command Center"
	@echo "make init            初始化项目"
	@echo "make setup           设置开发环境"
	@echo "make lint            运行代码检查"
	@echo "make test            运行测试"
	@echo "make build           运行构建"
	@echo "make ci              运行CI本地模拟"
	@echo "make quality         运行质量检查"
	@echo "make security        运行安全检查"
	@echo "make release         发布流程检查"

